# Identifiants de la boite mail info@atout-flair.ch.
# A renseigner dans Vercel (Settings -> Environment Variables), jamais dans le depot.

# Code d'acces partage, demande une seule fois par appareil. Obligatoire :
# sans lui, l'adresse du site suffirait a envoyer des mails depuis la boite.
APP_CODE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=info@atout-flair.ch
SMTP_PASS=

# Optionnels : des valeurs par defaut sont deja appliquees cote serveur.
MAIL_FROM="Atout-Flair Sàrl <info@atout-flair.ch>"
MAIL_REPLY_TO=info@atout-flair.ch
MAIL_BCC=

# Carte de la tournee, sur le tableau de l'accueil (Google Maps Embed API).
# Contrairement aux autres, cette cle part dans le code envoye au navigateur :
# la restreindre au domaine du site (HTTP referrer) dans la console Google Cloud,
# sinon n'importe qui peut la depenser. Sans elle, le tableau garde sa liste.
VITE_GOOGLE_MAPS_KEY=
